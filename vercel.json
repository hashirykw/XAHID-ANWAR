{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "xahid-anwar.nexlyr.solutions"
        }
      ],
      "destination": "https://englishwithsxa.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.englishwithsxa.com"
        }
      ],
      "destination": "https://englishwithsxa.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ai-checker.html",
      "destination": "/ai-checker",
      "permanent": true
    },
    {
      "source": "/portal.html",
      "destination": "/portal",
      "permanent": true
    },
    {
      "source": "/past-papers.html",
      "destination": "/past-papers",
      "permanent": true
    },
    {
      "source": "/books.html",
      "destination": "/books",
      "permanent": true
    },
    {
      "source": "/practice/xa-1-reading.html",
      "destination": "/practice/xa-1-reading",
      "permanent": true
    },
    {
      "source": "/practice/xa-1-reading-ms.html",
      "destination": "/practice/xa-1-reading-ms",
      "permanent": true
    },
    {
      "source": "/practice/xa-2-writing.html",
      "destination": "/practice/xa-2-writing",
      "permanent": true
    },
    {
      "source": "/practice/xa-2-writing-ms.html",
      "destination": "/practice/xa-2-writing-ms",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/assets/vendor/(.*).mjs",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, immutable"
        }
      ]
    }
  ]
}
